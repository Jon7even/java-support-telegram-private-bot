<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="003-create-user-status-table" author="Jon7even" context="dev" dbms="postgresql">

        <createTable tableName="user_status" schemaName="bot">

            <column name="chat_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_status"/>
            </column>

            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <rollback>
            <dropTable tableName="user_status" schemaName="bot"/>
        </rollback>

    </changeSet>

</databaseChangeLog>